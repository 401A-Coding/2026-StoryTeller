<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:orientation="vertical">

    <!-- 系列文件夹封面卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 文件夹渐变背景（紫调区别于普通书本） -->
            <View
                android:id="@+id/v_folder_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 模拟叠放效果：第二层书脊偏移 -->
            <View
                android:id="@+id/v_stack_1"
                android:layout_width="16dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginEnd="24dp"
                android:alpha="0.3"
                android:background="#FFFFFF" />

            <!-- 模拟叠放效果：第三层书脊偏移 -->
            <View
                android:id="@+id/v_stack_2"
                android:layout_width="16dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:alpha="0.2"
                android:background="#FFFFFF" />

            <!-- 文件夹图标 -->
            <TextView
                android:id="@+id/tv_folder_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="32dp"
                android:text="📁"
                android:textSize="48sp" />

            <!-- 系列名 -->
            <TextView
                android:id="@+id/tv_folder_series_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="36dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 书本数量 -->
            <TextView
                android:id="@+id/tv_folder_book_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 信息区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <!-- 系列名（重复显示，与独立书籍标题区对齐） -->
        <TextView
            android:id="@+id/tv_series_title_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- 摘要信息 -->
        <TextView
            android:id="@+id/tv_folder_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</LinearLayout>
