<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 基本信息卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E6E6E6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="基本信息"
                    android:textColor="#444444"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 标题 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="标题 *"
                    android:textColor="#1F1F1F"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_architecture_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_outline_edittext"
                    android:hint="请输入作品标题"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textSize="15sp" />

                <!-- 系列/类型 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="系列/类型"
                    android:textColor="#1F1F1F"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spinner_genre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_outline_edittext"
                    android:padding="12dp"
                    android:spinnerMode="dropdown" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 描述信息卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E6E6E6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="描述信息"
                    android:textColor="#444444"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 简介 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="简介"
                    android:textColor="#1F1F1F"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_architecture_description"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_outline_edittext"
                    android:gravity="top|start"
                    android:hint="输入作品简介，让读者快速了解故事内容"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_description_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="0/500"
                    android:textColor="#999999"
                    android:textSize="12sp" />

                <!-- 大纲 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="大纲（可选）"
                    android:textColor="#1F1F1F"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_architecture_outline"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_outline_edittext"
                    android:gravity="top|start"
                    android:hint="输入故事的主要情节脉络"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textSize="14sp" />

                <!-- 总结 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="总结（可选）"
                    android:textColor="#1F1F1F"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_architecture_summary"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_outline_edittext"
                    android:gravity="top|start"
                    android:hint="整体评价和风格说明"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 保存按钮 -->
        <Button
            android:id="@+id/btn_save_architecture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:padding="14dp"
            android:text="保存修改"
            android:textAllCaps="false"
            android:textSize="16sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
