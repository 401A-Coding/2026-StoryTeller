<?xml version="1.0" encoding="utf-8"?>
<!-- 章节卡片布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:orientation="vertical">

    <!-- 章节标题卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_chapter_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/desc_chapter_icon"
                android:src="@drawable/ic_insert_drive_file"
                app:tint="#4CAF50" />

            <TextView
                android:id="@+id/tv_chapter_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="第1章 · "
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_chapter_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:text="第1章"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:saveEnabled="false" />

            <TextView
                android:id="@+id/tv_chapter_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="第1章"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_more_chapter"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_more"
                android:src="@drawable/ic_more_vert"
                app:tint="#666666" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_chapter_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FAFAFA"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="#E6E6E6"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/writing_reference_chapter_title"
                android:textColor="#444444"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_chapter_reference_plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#333333"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_chapter_reference_characters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#333333"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 正文编辑区域 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp">

        <EditText
            android:id="@+id/et_chapter_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/hint_start_writing"
            android:inputType="textMultiLine"
            android:lineSpacingExtra="4dp"
            android:minHeight="200dp"
            android:padding="16dp"
            android:textColor="#333333"
            android:textColorHint="#BDBDBD"
            android:textSize="15sp"
            android:saveEnabled="false" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
