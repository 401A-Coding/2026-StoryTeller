<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary">

    <!-- AI边栏标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/background_secondary">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_robot"
            android:layout_marginEnd="8dp"
            android:contentDescription="AI" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI助手"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- 设置按钮 -->
        <ImageView
            android:id="@+id/btn_ai_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:padding="4dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="设置"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_close_ai"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:padding="4dp"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- AI聊天记录 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- 加载进度条 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- AI输入区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/background_card">

        <!-- 快捷操作按钮 -->
        <HorizontalScrollView
            android:id="@+id/scroll_quick_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:descendantFocusability="blocksDescendants">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_quick_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:chipSpacingHorizontal="8dp">
                <!-- 动态添加 Chip -->
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- 输入框 -->
        <EditText
            android:id="@+id/et_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="输入指令，如：续写下一章、优化这段文字..."
            android:background="@drawable/bg_outline_edittext"
            android:padding="12dp"
            android:minHeight="44dp"
            android:inputType="textMultiLine"
            android:imeOptions="actionSend"
            android:maxLines="4" />

        <!-- 模式选择和发送按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- 模式选择（Agent/Ask） -->
            <Button
                android:id="@+id/btn_mode_selector"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Agent"
                android:textSize="12sp"
                android:textColor="@color/colorPrimary"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textAllCaps="false"
                android:drawableEnd="@drawable/ic_arrow_drop_down"
                android:drawablePadding="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="32dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorPrimary"
                app:cornerRadius="4dp" />

            <!-- 模型选择（Flash/Pro） -->
            <Button
                android:id="@+id/btn_model_selector"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Flash"
                android:textSize="12sp"
                android:textColor="@color/colorPrimary"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textAllCaps="false"
                android:drawableEnd="@drawable/ic_arrow_drop_down"
                android:drawablePadding="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="32dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorPrimary"
                app:cornerRadius="4dp" />

            <!-- Agent模式设置按钮（写作/设定/大纲/文档） -->
            <ImageButton
                android:id="@+id/btn_agent_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_preferences"
                android:contentDescription="Agent模式设置"
                android:padding="8dp"
                android:visibility="gone"
                app:tint="@color/colorPrimary" />

            <!-- 占位符，将发送按钮推到最右侧 -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 发送按钮 -->
            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="发送"
                android:padding="12dp"
                app:tint="@color/colorPrimary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
