<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主内容区域 -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- 顶部工具栏 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary">

    <!-- 左侧：小说信息按钮（汉堡菜单） -->
    <ImageView
        android:id="@+id/btn_story_info"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start"
        android:contentDescription="小说信息"
        android:src="@drawable/ic_menu"
        android:padding="12dp" />

            <!-- 右侧：AI图标和保存图标 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_ai"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="AI助手"
                    android:src="@drawable/ic_robot"
                    android:padding="12dp" />

                <ImageView
                    android:id="@+id/btn_save"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="保存"
                    android:src="@drawable/ic_save"
                    android:padding="12dp" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 主内容区域 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layout_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 动态内容将通过代码添加 -->

            <!-- 添加新卷按钮 -->
            <Button
                android:id="@+id/btn_add_volume"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:text="@string/btn_add_volume"
                android:textAllCaps="false"
                android:textColor="#1976D2" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

        <!-- 加载进度条 -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 小说信息左侧悬浮栏 -->
    <LinearLayout
        android:id="@+id/panel_story_info"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- 小说标题行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="#1976D2">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_book_info"
                android:layout_marginEnd="8dp"
                android:contentDescription="小说信息" />

            <!-- 小说名称和下拉按钮的组合容器 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_story_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前小说"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- 下拉选择小说按钮 -->
                <ImageView
                    android:id="@+id/btn_select_story"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    android:padding="4dp"
                    android:contentDescription="选择小说"
                    app:tint="#FFFFFF" />
            </LinearLayout>

            <!-- 收起按钮（固定在右侧） -->
            <ImageView
                android:id="@+id/btn_close_story_info"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:padding="4dp"
                android:contentDescription="收起"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Tab 切换栏 -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_story_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            app:tabIndicatorColor="#1976D2"
            app:tabSelectedTextColor="#1976D2"
            app:tabTextColor="#666666"
            app:tabMode="fixed"
            app:tabGravity="fill">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设定" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="大纲" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="目录" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="文档" />
        </com.google.android.material.tabs.TabLayout>

        <!-- 内容区域 -->
        <FrameLayout
            android:id="@+id/layout_story_info_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- 设定区域 -->
            <ScrollView
                android:id="@+id/panel_setting"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📖 世界观设定"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp" />
                    <EditText
                        android:id="@+id/et_world_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="输入世界观设定..."
                        android:background="@drawable/bg_outline_edittext"
                        android:padding="12dp"
                        android:minHeight="120dp"
                        android:gravity="top"
                        android:inputType="textMultiLine" />
                </LinearLayout>
            </ScrollView>

            <!-- 大纲区域 -->
            <ScrollView
                android:id="@+id/panel_outline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📝 故事大纲"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp" />
                    <EditText
                        android:id="@+id/et_outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="输入故事大纲..."
                        android:background="@drawable/bg_outline_edittext"
                        android:padding="12dp"
                        android:minHeight="120dp"
                        android:gravity="top"
                        android:inputType="textMultiLine" />
                </LinearLayout>
            </ScrollView>

            <!-- 目录区域 -->
            <ScrollView
                android:id="@+id/panel_toc"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/layout_toc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📚 目录概览"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp" />
                    <!-- 动态填充卷章列表 -->
                </LinearLayout>
            </ScrollView>

            <!-- 文档区域 -->
            <ScrollView
                android:id="@+id/panel_docs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📄 参考资料"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp" />
                    <EditText
                        android:id="@+id/et_docs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="输入参考资料..."
                        android:background="@drawable/bg_outline_edittext"
                        android:padding="12dp"
                        android:minHeight="120dp"
                        android:gravity="top"
                        android:inputType="textMultiLine" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- AI 助手右侧边栏 -->
    <LinearLayout
        android:id="@+id/panel_ai"
        android:layout_width="350dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- AI边栏标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="#F5F5F5">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_robot"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/ai" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ai_assistant"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <ImageView
                android:id="@+id/btn_close_ai"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:padding="4dp"
                android:contentDescription="@string/close" />
        </LinearLayout>

        <!-- AI聊天记录 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false" />

        <!-- AI输入区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF">

            <!-- 输入框 -->
            <EditText
                android:id="@+id/et_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="@string/enter_message"
                android:background="@drawable/bg_outline_edittext"
                android:padding="12dp"
                android:minHeight="44dp"
                android:inputType="textMultiLine"
                android:imeOptions="actionSend"
                android:maxLines="4" />

            <!-- 模式选择和发送按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <!-- 模式选择（Agent/Ask） -->
                <Button
                    android:id="@+id/btn_mode_selector"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/agent"
                    android:textSize="12sp"
                    android:textColor="@color/colorPrimary"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textAllCaps="false"
                    android:drawableEnd="@drawable/ic_arrow_drop_down"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/colorPrimary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="32dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/colorPrimary"
                    app:cornerRadius="4dp" />

                <!-- 模型选择（Flash/Pro） -->
                <Button
                    android:id="@+id/btn_model_selector"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/model_flash"
                    android:textSize="12sp"
                    android:textColor="@color/colorPrimary"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textAllCaps="false"
                    android:drawableEnd="@drawable/ic_arrow_drop_down"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/colorPrimary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="32dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/colorPrimary"
                    app:cornerRadius="4dp" />

                <!-- 占位符，将发送按钮推到最右侧 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- 发送按钮 -->
                <ImageButton
                    android:id="@+id/btn_send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_send"
                    android:contentDescription="@string/action_send"
                    android:padding="12dp"
                    app:tint="@color/colorPrimary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>

