<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主内容区域 -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- 顶部工具栏 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary">

            <!-- 左侧：返回箭头 -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start"
                android:contentDescription="返回"
                android:src="@drawable/ic_arrow_back"
                android:padding="12dp" />

            <!-- 右侧：AI图标和保存图标 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_ai"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="AI助手"
                    android:src="@drawable/ic_robot"
                    android:padding="12dp" />

                <ImageView
                    android:id="@+id/btn_save"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="保存"
                    android:src="@drawable/ic_save"
                    android:padding="12dp" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 主内容区域 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layout_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 动态内容将通过代码添加 -->

            <!-- 添加新卷按钮 -->
            <Button
                android:id="@+id/btn_add_volume"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:text="@string/btn_add_volume"
                android:textAllCaps="false"
                android:textColor="#1976D2" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

        <!-- 加载进度条 -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- AI 助手右侧边栏 -->
    <LinearLayout
        android:id="@+id/panel_ai"
        android:layout_width="350dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- AI边栏标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="#F5F5F5">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_robot"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/ai" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ai_assistant"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <ImageView
                android:id="@+id/btn_close_ai"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:padding="4dp"
                android:contentDescription="@string/close" />
        </LinearLayout>

        <!-- AI聊天记录 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false" />

        <!-- AI输入区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF">

            <!-- 输入框 -->
            <EditText
                android:id="@+id/et_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="@string/enter_message"
                android:background="@drawable/bg_outline_edittext"
                android:padding="12dp"
                android:minHeight="44dp"
                android:inputType="textMultiLine"
                android:imeOptions="actionSend"
                android:maxLines="4" />

            <!-- 模式选择和发送按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <!-- 模式选择 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Agent 模式按钮 -->
                        <Button
                            android:id="@+id/btn_agent_mode"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/agent"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textAllCaps="false"
                            android:drawableStart="@drawable/ic_robot"
                            android:drawablePadding="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="32dp" />

                        <!-- 分隔线 -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="#E0E0E0"
                            android:layout_gravity="center_vertical" />

                        <!-- Ask 模式按钮 -->
                        <Button
                            android:id="@+id/btn_ask_mode"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ask"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textAllCaps="false"
                            android:drawableStart="@android:drawable/ic_menu_help"
                            android:drawablePadding="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="32dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 无形隐藏的spacer用来推送按钮到右侧 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- 发送按钮 -->
                <ImageButton
                    android:id="@+id/btn_send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_send"
                    android:contentDescription="@string/action_send"
                    android:padding="12dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>

