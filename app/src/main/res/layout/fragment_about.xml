<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 页面标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_about"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal" />

    <!-- 应用图标和名称 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="32dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@mipmap/ic_launcher"
            android:background="@drawable/ic_launcher_background"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="版本 1.0"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 应用介绍区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btn_check_update"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检查更新"
            app:icon="@drawable/ic_refresh"
            app:iconTint="@color/colorPrimary" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/divider"
            android:layout_marginHorizontal="16dp" />

        <Button
            android:id="@+id/btn_project_page"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="项目主页"
            app:icon="@drawable/ic_book_info"
            app:iconTint="@color/colorPrimary" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp" />

    <!-- 功能链接 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="相关链接"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_github"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GitHub 仓库"
        android:gravity="start|center_vertical"
        android:paddingStart="0dp"
        app:icon="@drawable/ic_robot"
        app:iconTint="@color/colorPrimary" />

    <Button
        android:id="@+id/btn_feedback"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="问题反馈"
        android:gravity="start|center_vertical"
        android:paddingStart="0dp"
        app:icon="@drawable/ic_insert_drive_file"
        app:iconTint="@color/colorPrimary" />

    <Button
        android:id="@+id/btn_license"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开源许可证"
        android:gravity="start|center_vertical"
        android:paddingStart="0dp"
        app:icon="@drawable/ic_menu"
        app:iconTint="@color/colorPrimary" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp" />

    <!-- 版权信息 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="© 2024-2026 StoryTeller\n基于 MIT 许可证开源"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        android:lineSpacingMultiplier="1.5" />

</LinearLayout>