<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_settings"
        android:textSize="22sp"
        android:layout_gravity="center_horizontal" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_models_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="模型"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tv_models_title_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="添加、删除你的模型，启用或禁用它们。"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tv_models_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_models"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_models_title_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_add_model"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_model"
        app:layout_constraintTop_toBottomOf="@id/rv_models"
        android:layout_marginTop="16dp" />

    <View
        android:id="@+id/divider_appearance"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/btn_add_model"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tv_appearance_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_appearance"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/divider_appearance"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_theme_mode_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_mode"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/tv_appearance_title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_theme_mode_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_mode_system"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toTopOf="@id/tv_theme_mode_label"
        app:layout_constraintBottom_toBottomOf="@id/tv_theme_mode_label"
        app:layout_constraintEnd_toStartOf="@id/iv_theme_arrow" />

    <ImageView
        android:id="@+id/iv_theme_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_drop_down"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/tv_theme_mode_label"
        app:layout_constraintBottom_toBottomOf="@id/tv_theme_mode_label"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"
        android:rotation="270" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/tv_theme_mode_label"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_writing_preference_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="写作偏好设置"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_writing_preference_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="设置全局默认的写作风格、叙事视角等偏好。新建小说时将自动应用这些设置。"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tv_writing_preference_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_global_writing_preference"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="配置全局写作偏好"
        app:layout_constraintTop_toBottomOf="@id/tv_writing_preference_desc"
        android:layout_marginTop="12dp" />

    <View
        android:id="@+id/divider_help"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/btn_global_writing_preference"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tv_support_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_support"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/divider_help"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btn_help"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/title_help"
        app:layout_constraintTop_toBottomOf="@id/tv_support_title"
        tools:layout_editor_absoluteX="24dp" />

    <Button
        android:id="@+id/btn_about"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/title_about"
        app:layout_constraintTop_toBottomOf="@id/btn_help" />

    <Button
        android:id="@+id/btn_feedback"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/title_feedback"
        app:layout_constraintTop_toBottomOf="@id/btn_about" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>