<?xml version="1.0" encoding="utf-8"?>
<!-- 卷卡片布局 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_volume"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 卷标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/desc_volume_icon"
                android:src="@drawable/ic_menu_book"
                app:tint="#1976D2" />

            <TextView
                android:id="@+id/tv_volume_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="第1卷 · "
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_volume_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:text="卷名"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:saveEnabled="false" />

            <TextView
                android:id="@+id/tv_volume_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="卷名"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 更多操作按钮 -->
            <ImageView
                android:id="@+id/btn_more_volume"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_more"
                android:padding="4dp"
                android:src="@drawable/ic_more_vert"
                app:tint="#666666" />
        </LinearLayout>

        <!-- 章节容器 -->
        <LinearLayout
            android:id="@+id/layout_chapters_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <!-- 添加章节按钮 -->
        <Button
            android:id="@+id/btn_add_chapter"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="@string/btn_add_chapter"
            android:textAllCaps="false"
            android:textColor="#1976D2" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
