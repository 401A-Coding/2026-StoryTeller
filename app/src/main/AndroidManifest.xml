<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StoryTeller">
        <activity
            android:name=".ui.activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true" />
        <activity
            android:name=".ui.activity.StoryWorkspaceActivity"
            />
        <activity
            android:name=".ui.activity.CharacterActivity"
            />
        <activity
            android:name=".ui.activity.PlotTreeActivity"
            />
        <activity
            android:name=".ui.activity.SettingDetailActivity"
            />
        <activity
            android:name=".ui.activity.AiMemoryActivity"
            android:label="AI记忆管理" />
        <activity
            android:name=".ui.activity.MemoryDetailActivity"
            android:label="记忆详情" />
        <activity
            android:name=".ui.activity.NovelDetailActivity"
            />
        <activity
            android:name=".ui.activity.DocumentEditorActivity"
            android:label="文档编辑" />
        <activity
            android:name=".ui.activity.PlotGraphActivity"
            android:label="关系图" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>